<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
  <table cellpadding="0" cellspacing="0" width="100%" style="background:#f4f5f7;padding:48px 20px;">
    <tr>
      <td align="center">
        <table cellpadding="0" cellspacing="0" width="560" style="max-width:560px;width:100%;">

          <!-- Logo -->
          <tr>
            <td align="center" style="padding:0 0 24px;">
              <span style="font-size:20px;font-weight:700;color:#111827;letter-spacing:-0.3px;">✉ MyApp</span>
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;">
              <table cellpadding="0" cellspacing="0" width="100%">

                <tr>
                  <td style="padding:36px 40px 28px;">
                    <h1 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 14px;line-height:1.3;">
                      Confirm your email address
                    </h1>
                    <p style="font-size:15px;line-height:1.7;color:#6b7280;margin:0 0 28px;">
                      Hi <%= @user_name %>, please verify your email to complete your account setup. This link expires in <strong style="color:#374151;">24 hours</strong>.
                    </p>
                    <a href="<%= @confirmation_url %>" style="display:inline-block;background:#16a34a;color:#ffffff;padding:13px 28px;border-radius:7px;text-decoration:none;font-weight:600;font-size:15px;">
                      Confirm email address
                    </a>
                  </td>
                </tr>

                <tr>
                  <td style="padding:0 40px 28px;border-top:1px solid #f3f4f6;">
                    <p style="font-size:13px;color:#9ca3af;margin:20px 0 4px;">
                      Or copy and paste this link into your browser:
                    </p>
                    <p style="font-size:13px;color:#6b7280;margin:0;word-break:break-all;"><%= @confirmation_url %></p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:24px 0;">
              <p style="font-size:12px;color:#9ca3af;margin:0;">
                © 2026 MyApp · You're receiving this because you signed up.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
