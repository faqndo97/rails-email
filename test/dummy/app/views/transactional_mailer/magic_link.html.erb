<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background-color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
  <table cellpadding="0" cellspacing="0" width="100%" style="background:#0a0a0a;padding:48px 20px;">
    <tr>
      <td align="center">
        <table cellpadding="0" cellspacing="0" width="560" style="max-width:560px;width:100%;">

          <!-- Card -->
          <tr>
            <td style="background:#111111;border-radius:12px;overflow:hidden;border:1px solid #222222;">
              <table cellpadding="0" cellspacing="0" width="100%">

                <!-- Header -->
                <tr>
                  <td style="padding:24px 32px;border-bottom:1px solid #222222;">
                    <span style="font-size:15px;font-weight:600;color:#e5e5e5;">✉ MyApp</span>
                  </td>
                </tr>

                <!-- Main content -->
                <tr>
                  <td style="padding:32px 32px 28px;border-bottom:1px solid #222222;">
                    <h1 style="font-size:20px;font-weight:700;color:#ffffff;margin:0 0 12px;line-height:1.3;">
                      Sign in to your account
                    </h1>
                    <p style="font-size:14px;line-height:1.7;color:#888888;margin:0 0 28px;">
                      Click the button below to sign in. This link is single-use and
                      expires in <strong style="color:#e5e5e5;"><%= @expires_in %></strong>.
                    </p>
                    <a href="<%= @magic_url %>" style="display:block;background:#16a34a;color:#ffffff;text-align:center;padding:14px 28px;border-radius:7px;text-decoration:none;font-weight:600;font-size:15px;">
                      Sign in to MyApp
                    </a>
                  </td>
                </tr>

                <!-- Fallback URL -->
                <tr>
                  <td style="padding:20px 32px;border-bottom:1px solid #222222;">
                    <p style="font-size:12px;color:#555555;margin:0 0 6px;">
                      If the button doesn't work, copy and paste this link in your browser:
                    </p>
                    <p style="font-size:12px;color:#888888;margin:0;word-break:break-all;"><%= @magic_url %></p>
                  </td>
                </tr>

                <!-- Footer note -->
                <tr>
                  <td style="padding:20px 32px;">
                    <p style="font-size:12px;color:#555555;margin:0;">
                      If you didn't request this link, you can safely ignore this email.
                      Your account remains secure.<br>
                      © 2026 MyApp · Transactional email
                    </p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
